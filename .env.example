# Copiar como .env y completar con valores reales. .env nunca se sube a git.

POSTGRES_DB=contabilidadRestaurante
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA

# Clave larga y aleatoria (ej: openssl rand -base64 48)
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_SECRETA_LARGA

# Puertos publicados en el host (solo se usan en local con docker-compose.yml;
# docker-compose.deploy.yml no publica puertos, ver deploy/shared-caddy.md)
BACKEND_PORT=8080
FRONTEND_PORT=8081

PROPINAS_ENABLED=false

# Solo para docker-compose.deploy.yml: tag de imagen a desplegar (por defecto
# "latest", la que publica build-image.yml en cada push a master). Tambien
# se puede fijar a un tag de version (vX.Y.Z) o a un sha-<commit> puntual.
IMAGE_TAG=latest
